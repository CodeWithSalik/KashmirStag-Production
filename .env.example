# ─── Database ─────────────────────────────────────────────
# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kashmirstag?retryWrites=true&w=majority"

# ─── Authentication ──────────────────────────────────────
# Secret for signing JWT tokens (min 32 chars, generate with: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated admin email addresses (auto-promoted on first login)
ADMIN_EMAILS=owner@example.com

# ─── Razorpay ────────────────────────────────────────────
# Public key (exposed to browser for checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only keys (NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signature verification secret (Dashboard → Webhooks → Secret)
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (SMTP) ────────────────────────────────────────
# SMTP connection for transactional emails (order confirmations, password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KashmirStag <noreply@kashmirstag.com>"

# ─── Application ─────────────────────────────────────────
# Public base URL (used for email links, sitemap, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Legacy Migration (remove after all passwords migrated) ──
# AES secret for decrypting legacy passwords during transparent migration
AES_SECRET=
