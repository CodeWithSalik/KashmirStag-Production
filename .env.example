# ─── Database ─────────────────────────────────────────────
# MongoDB Atlas connection string (replica set required for transactions)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kashmirstag?retryWrites=true&w=majority"

# ─── Authentication ──────────────────────────────────────
# Secret for signing JWT tokens (min 32 chars, generate with: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated admin email addresses (auto-promoted on first login)
ADMIN_EMAILS=owner@example.com

# ─── Razorpay ────────────────────────────────────────────
# Public key (exposed to browser for checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Server-only keys (NEVER prefix with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook signature verification secret (Dashboard → Webhooks → Secret)
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (Next.js Mail / Transactional Email System) ───
# Next.js Direct TLS Provider (Port 465 SSL, Fragments Architecture)
MAIL_USER=
MAIL_PASS=
MAIL_FROM="KashmirStag <pirzadasalik116@gmail.com>"

# Compatible environment aliases (used in Fragments of Me)
EMAIL_USER=
EMAIL_PASS=
FROM_EMAIL="KashmirStag <pirzadasalik116@gmail.com>"

# Optional: Resend API Provider (when verified domain available)
RESEND_API_KEY=
RESEND_FROM=

# Customer support notification recipient
SUPPORT_EMAIL=pirzadasalik116@gmail.com


# ─── Application ─────────────────────────────────────────
# Public base URL (used for email links, sitemap, OG tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Legacy Migration (remove after all passwords migrated) ──
# AES secret for decrypting legacy passwords during transparent migration
AES_SECRET=
